{
  "name": "pkcamp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "sprites:generate": "node scripts/generate-sprite-catalog.mjs && node scripts/generate-pokemondb-catalog.mjs && node scripts/generate-pmdcollab-catalog.mjs",
    "build:pkhex-wasm": "cd vendor/pkhex-wasm && npm --prefix tools/package ci && node tools/package/build-package.mjs --version 0.2.0 && rm -rf dist && cp -R artifacts/pkg-dist/package dist",
    "setup:pkhex-wasm": "node scripts/setup-pkhex-wasm.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "pkhex-wasm": "file:./vendor/pkhex-wasm/dist",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
